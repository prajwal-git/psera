rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.admin == true; }
  match /products/{id} { allow read: if resource.data.active == true || admin(); allow write: if false; }
  match /categories/{id} { allow read: if true; allow write: if false; }
  match /banners/{id} { allow read: if true; allow write: if false; }
  match /settings/{id} { allow read: if true; allow write: if false; }
  match /orders/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin()); allow write: if false; }
  match /users/{uid} {
   allow read: if signedIn() && (request.auth.uid == uid || admin());
   allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','phone','email']) && request.resource.data.name is string && request.resource.data.name.size() <= 100;
   allow delete: if signedIn() && request.auth.uid == uid;
   match /addresses/{id} { allow read, write: if signedIn() && request.auth.uid == uid; }
   match /wishlist/{id} { allow read, write: if signedIn() && request.auth.uid == uid; }
   match /cart/{id} { allow read, write: if signedIn() && request.auth.uid == uid; }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
